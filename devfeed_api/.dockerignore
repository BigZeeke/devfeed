.env
.env.*

# Python caches and local virtual environments
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Local SQLite database and OS clutter
db.sqlite3
.DS_Store

# Docker files themselves are not needed inside the image
Dockerfile
.dockerignore
