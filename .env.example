# .env.example (committed, placeholders only)

# Required. Generate a unique key per environment with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Wrap the value in single quotes.
SECRET_KEY=
# Used when Django runs outside Docker; docker-compose.yml overrides it.
DATABASE_URL=postgres://user:password@localhost:5432/devfeed
# Optional: GitHub personal access token (Public Repositories, read-only).
# Leave empty to run unauthenticated at the lower rate limit.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Debug mode. Keep False here so a copied production .env fails safe;
# set True in your local .env for development.
DEBUG=False
# Comma-separated host names this server answers to.
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated browser origins allowed to call the API (scheme, no trailing
# slash). Local dev: http://localhost:5173,http://127.0.0.1:5173 (Vite).
# Leave empty in production, where NGINX serves both on one origin.
CORS_ALLOWED_ORIGINS=
# Docker Compose database (docker-compose.yml). The db container creates this
# database and user on first start, and the backend container builds its
# DATABASE_URL from these values. Use a hex password so it is safe in a URL:
# python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_DB=devfeed
POSTGRES_USER=devfeed
POSTGRES_PASSWORD=
