# .env.example (committed, placeholders only)

# Required. Generate a unique key per environment with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Wrap the value in single quotes.
SECRET_KEY=
DATABASE_URL=postgres://user:password@localhost:5432/devfeed
# Optional: GitHub personal access token (Public Repositories, read-only).
# Leave empty to run unauthenticated at the lower rate limit.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Debug mode. Keep False here so a copied production .env fails safe;
# set True in your local .env for development.
DEBUG=False
# Comma-separated host names this server answers to.
ALLOWED_HOSTS=127.0.0.1,localhost
